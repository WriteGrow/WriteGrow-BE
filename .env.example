# docker-compose.prod.yml 이 읽는 값들.
# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 git 에 올리지 않는다.

# --- 데이터베이스 (같은 서버 컨테이너) ---
POSTGRES_DB=writegrow
POSTGRES_USER=writegrow
POSTGRES_PASSWORD=

# --- S3 (손글씨 원본 저장) ---
# dev 와 같은 버킷을 쓰고 key-prefix(prod/) 로 영역만 나눈다.
# 저장소는 AWS S3 지만 서버는 AWS 가 아니라 IAM 역할을 쓸 수 없으므로 키를 직접 넣는다.
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- AI 분석 서버 ---
# AI 컨테이너를 같은 compose 네트워크에 띄우고 서비스 이름으로 부른다.
# AI_STUB=true 면 백엔드가 고정 응답을 쓰고 AI 서버를 호출하지 않는다.
AI_STUB=false
AI_BASE_URL=http://ai:8000

# AI 이미지에는 들어 있지 않다. 없으면 AI 서버는 뜨지만 OCR 과 오류 분석만 실패한다.
# 인증이 없는 공개 API 라 호출량이 곧 비용이므로, OpenAI 대시보드에서 사용량 한도를 걸어 둔다.
OPENAI_API_KEY=

# --- API 문서 ---
# 프론트 연동 기간에만 연다. 인증이 없으므로 시연이 끝나면 false 로 되돌린다.
SWAGGER_ENABLED=true
