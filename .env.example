# docker-compose.prod.yml 이 읽는 값들.
# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 git 에 올리지 않는다.

# --- 데이터베이스 (같은 서버 컨테이너) ---
POSTGRES_DB=writegrow
POSTGRES_USER=writegrow
POSTGRES_PASSWORD=

# --- AWS S3 (손글씨 원본 저장) ---
# LocalStack 이 아니라 실제 버킷이 필요하다.
S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI 분석 서버 ---
# 아직 배포 전이면 임의 값을 두고, application-prod.yml 의
# writegrow.ai.stub 을 true 로 바꿔 stub 으로 동작시킨다.
AI_BASE_URL=http://ai:8000
